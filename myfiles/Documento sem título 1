#include <stdlib.h>
#include <stdio.h>
#include <unistd.h>

#define KB 1024
#define MB 1024*KB

int main() {
	int i;
	char c;
	char *m = malloc(500*MB*sizeof(char));
	
	for(i=0;i<500*MB;i+=4*KB) {
		m[i] = '*';
	}

	sleep(4);

	for(i=0;i<100*MB;i+=4*KB)
		c = m[i];
	for(i=100*MB;i<500*MB;i+=4*KB)
		m[i] = '*';

	return 0;
}
